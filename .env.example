# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit it.

# Public site URL — used for canonical URLs, OG tags, sitemap, robots.
# Production:  https://logyra.in
# Dev/staging: https://dev.logyra.hub29.online  (non-production hosts auto-noindex)
# Leave empty in production to default to https://logyra.in.
NEXT_PUBLIC_SITE_URL=

# Telegram contact form
# Bot token from @BotFather (https://t.me/BotFather → /mybots → API Token)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID where contact submissions will be sent
# Get via: https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot
TELEGRAM_CHAT_ID=
